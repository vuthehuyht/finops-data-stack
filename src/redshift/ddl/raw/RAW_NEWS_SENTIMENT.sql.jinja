-- Create RAW table: RAW_NEWS_SENTIMENT
-- Written by the nlp_publish_sentiment_scores Dagster asset via
-- load_s3_to_redshift(). No DROP here on purpose: scores are expensive to
-- recompute, so re-running the DDL job must not wipe them.
CREATE TABLE IF NOT EXISTS "{{ schema_name_raw }}"."RAW_NEWS_SENTIMENT" (
  ARTICLE_ID VARCHAR(256),
  SENTIMENT_SCORE NUMERIC(18, 4),
  SENTIMENT_LABEL VARCHAR(32),
  MODEL_VERSION VARCHAR(256),
  BATCH_DATE DATE,
  _CONATA_SOURCE VARCHAR(256),
  _CONATA_SOURCE_ROW_NUMBER INTEGER,
  _CONATA_PARTITION_KEY VARCHAR(256),
  _CONATA_LOADED_AT TIMESTAMP
);
